# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — keep secrets here, never commit them.

# Notion integration secret. Create one at https://www.notion.so/my-integrations
# (Internal integration → copy the "Internal Integration Secret".)
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion database ID. Open your concepts database as a full page in Notion,
# copy the URL, and take the 32-char hex chunk before the "?":
#   https://www.notion.so/your-workspace/<DATABASE_ID>?v=...
# Hyphens optional; the script normalises them.
NOTION_DATABASE_ID=00000000000000000000000000000000

# --- Upstash Redis (optional, for view counting) ---
# When set, the detail pages bump a view counter and the /list page sorts by
# view count. Free tier is plenty for a personal site.
# Create a database at https://console.upstash.com/redis → copy the REST
# credentials. On Vercel: Integrations → Upstash → install → connect → env vars
# get added automatically.
UPSTASH_REDIS_REST_URL=https://xxxxxxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
